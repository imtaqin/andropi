<?xml version="1.0" encoding="utf-8"?>
<!-- Google Play build: no "All files access". Projects live in the app's workspace; files come in through the
     picker (Import) and go out through MediaStore (Save to Downloads) or the share sheet. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:node="remove"/>
</manifest>
